# URL Apps Script: deployment type Web app, execute as owner, anyone (signed POST only).
GOOGLE_APPS_SCRIPT_URL=
# Must match Apps Script property BRIDGE_SECRET. Generate 32+ random bytes.
BRIDGE_SECRET=
# Random 32+ bytes; used for bot challenge signatures and IP pseudonymization.
SESSION_SECRET=
# Use npm run secrets; enter the business admin/edit codes interactively.
ADMIN_RESULT_CODE_HASH=
BALLOT_EDIT_CODE_HASH=
APP_TIMEZONE=Asia/Ho_Chi_Minh
